{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "kpi",
      "queryLines": [
        "SELECT sum(cast(caught_by_notes as int)) caught, sum(cast(undocumented_ckd as int)) undoc, sum(cast(notes_risk_flag as int)) notes_flagged, count(*) patients FROM slhs_test1.ckd_prod.patient_ckd_analytics"
      ]
    },
    {
      "name": "by_risk",
      "displayName": "by_risk",
      "queryLines": [
        "SELECT notes_ckd_risk, count(*) patients FROM slhs_test1.ckd_prod.patient_ckd_analytics GROUP BY notes_ckd_risk ORDER BY 2 DESC"
      ]
    },
    {
      "name": "caught_by_stage",
      "displayName": "caught_by_stage",
      "queryLines": [
        "SELECT lab_kdigo_stage, sum(cast(caught_by_notes as int)) caught_by_notes FROM slhs_test1.ckd_prod.patient_ckd_analytics GROUP BY lab_kdigo_stage ORDER BY lab_kdigo_stage"
      ]
    },
    {
      "name": "caught_tbl",
      "displayName": "caught_tbl",
      "queryLines": [
        "SELECT patient_id, lab_kdigo_stage, round(mean_egfr,0) egfr, notes_ckd_risk, ckd_risk_score FROM slhs_test1.ckd_prod.patient_ckd_analytics WHERE caught_by_notes ORDER BY ckd_risk_score DESC LIMIT 25"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "CKD — Labs + Notes",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# CKD Identification — Labs + Notes Fusion\n",
                "Undiagnosed CKD surfaced from structured labs **and** AI-read clinical notes. **Caught by notes** = patients with normal labs, flagged only because the AI read their notes."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "w_caught",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi",
                  "fields": [
                    {
                      "name": "sum(undoc)",
                      "expression": "SUM(`undoc`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Undocumented CKD"
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(undoc)"
                }
              },
              "data": {
                "queryName": "main_query"
